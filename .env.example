# Google AI Studio API key (https://aistudio.google.com/apikey)
# Used by BOTH the embeddings script and the site's AI chat bot.
# You can use the same key for both variables.

# npm run embed — embeds content/rag/*.md into data/rag-vectors.jsonl
GOOGLE_API_KEY=

# app/api/bot — Vercel AI SDK (@ai-sdk/google) + query embeddings for the "Ask me about Roger" chat
GOOGLE_GENERATIVE_AI_API_KEY=

# After cloning: cp .env.example .env.local  (never commit .env.local)
# On Vercel: add both variables in Project Settings → Environment Variables
